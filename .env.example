# FinSentry AI — Environment Configuration
# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsentry

# Path where trained ML model artifacts are stored
MODEL_PATH=models/

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Number of records per database batch insert
BATCH_SIZE=1000

# Amount above which a transaction is flagged as "large"
LARGE_TRANSACTION_THRESHOLD=10000.0
